---
import type { Lang } from "@i18n/ui";
import { t, tf } from "@i18n/ui";
import { localizedHref } from "@data/nav";
import { contactInfo } from "@data/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-rule)] bg-[color:var(--color-canvas)]">
  <div class="container-wide py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-3">
        <a href={`/${lang}`} class="inline-flex items-center" aria-label={t(lang, "site.name")}>
          <img src="/sow-logo.png" alt={t(lang, "site.name")} class="h-7 w-auto" />
        </a>
        <p class="text-sm text-[color:var(--color-ink-3)] max-w-xs leading-relaxed">
          {t(lang, "footer.tagline")}
        </p>
      </div>

      <div>
        <h4 class="mb-3 text-sm font-semibold text-[color:var(--color-ink)]">
          {t(lang, "nav.programs")}
        </h4>
        <ul class="space-y-2 text-sm">
          <li><a href={localizedHref(lang, "/programs/senior-care")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.programs.senior_care")}</a></li>
          <li><a href={localizedHref(lang, "/programs/disaster-relief")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.programs.disaster_relief")}</a></li>
          <li><a href={localizedHref(lang, "/programs/poverty-relief")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.programs.poverty_relief")}</a></li>
          <li><a href={localizedHref(lang, "/programs/scholarship")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.programs.scholarship")}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="mb-3 text-sm font-semibold text-[color:var(--color-ink)]">
          {t(lang, "nav.tours")}
        </h4>
        <ul class="space-y-2 text-sm">
          <li><a href={localizedHref(lang, "/tours/holy-land")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.tours.holy_land")}</a></li>
          <li><a href={localizedHref(lang, "/tours/ark")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.tours.ark")}</a></li>
          <li><a href={localizedHref(lang, "/donate")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.donate")}</a></li>
          <li><a href={localizedHref(lang, "/contact")} class="text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">{t(lang, "nav.contact")}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="mb-3 text-sm font-semibold text-[color:var(--color-ink)]">
          {t(lang, "nav.contact")}
        </h4>
        <address class="not-italic text-sm space-y-1.5 text-[color:var(--color-ink-2)]">
          <div>{contactInfo.address}</div>
          <div><a href={`tel:${contactInfo.phone.replace(/[^0-9+]/g, "")}`} class="hover:underline">{contactInfo.phone}</a></div>
          <div><a href={`mailto:${contactInfo.emailContact}`} class="hover:underline">{contactInfo.emailContact}</a></div>
        </address>
      </div>
    </div>

    <div class="mt-10 border-t border-[color:var(--color-rule)] pt-6 text-xs text-[color:var(--color-ink-3)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p>{tf(lang, "footer.copyright", { year })}</p>
      <p>501(c)(3) Nonprofit</p>
    </div>
  </div>
</footer>
