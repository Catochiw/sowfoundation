---
import type { Lang } from "@i18n/ui";
import { t } from "@i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<form
  data-contact-form
  method="POST"
  action="/api/contact"
  class="space-y-5"
  novalidate
>
  <input type="hidden" name="lang" value={lang} />
  <!-- Honeypot -->
  <div class="absolute -left-[10000px]" aria-hidden="true">
    <label>Leave this empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div>
    <label for="cf-name" class="block text-sm font-medium text-[color:var(--color-ink)]">
      {t(lang, "contact.form.name")} <span class="text-[color:var(--color-error)]">*</span>
    </label>
    <input
      id="cf-name"
      name="name"
      type="text"
      required
      maxlength="120"
      autocomplete="name"
      class="mt-2 block w-full rounded-xl border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] px-4 py-3 text-base text-[color:var(--color-ink)] placeholder-[color:var(--color-ink-3)] shadow-sm focus:border-[color:var(--color-brand)] focus:ring-0 focus:outline-none"
    />
  </div>

  <div>
    <label for="cf-email" class="block text-sm font-medium text-[color:var(--color-ink)]">
      {t(lang, "contact.form.email")} <span class="text-[color:var(--color-error)]">*</span>
    </label>
    <input
      id="cf-email"
      name="email"
      type="email"
      required
      maxlength="200"
      autocomplete="email"
      class="mt-2 block w-full rounded-xl border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] px-4 py-3 text-base text-[color:var(--color-ink)] placeholder-[color:var(--color-ink-3)] shadow-sm focus:border-[color:var(--color-brand)] focus:ring-0 focus:outline-none"
    />
  </div>

  <div>
    <label for="cf-message" class="block text-sm font-medium text-[color:var(--color-ink)]">
      {t(lang, "contact.form.message")} <span class="text-[color:var(--color-error)]">*</span>
    </label>
    <textarea
      id="cf-message"
      name="message"
      required
      rows="6"
      maxlength="5000"
      class="mt-2 block w-full rounded-xl border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] px-4 py-3 text-base text-[color:var(--color-ink)] placeholder-[color:var(--color-ink-3)] shadow-sm focus:border-[color:var(--color-brand)] focus:ring-0 focus:outline-none resize-y"
    ></textarea>
  </div>

  {turnstileSiteKey && (
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
  )}

  <div class="flex items-center gap-4">
    <button
      type="submit"
      class="btn btn-primary"
      data-cf-submit
    >
      <span data-cf-label>{t(lang, "contact.form.submit")}</span>
    </button>
    <p
      class="text-sm hidden"
      data-cf-status
      role="status"
      aria-live="polite"
    ></p>
  </div>
</form>

{turnstileSiteKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<script is:inline define:vars={{ messages: {
  submit: t(lang, "contact.form.submit"),
  submitting: t(lang, "contact.form.submitting"),
  success: t(lang, "contact.form.success"),
  incomplete: t(lang, "contact.form.incomplete"),
  invalidEmail: t(lang, "contact.form.invalidEmail"),
  serverError: t(lang, "contact.form.serverError"),
  networkError: t(lang, "contact.form.networkError"),
}}}>
  const form = document.querySelector("[data-contact-form]");
  if (form) {
    const submit = form.querySelector("[data-cf-submit]");
    const label = form.querySelector("[data-cf-label]");
    const status = form.querySelector("[data-cf-status]");
    const nameEl = form.querySelector("#cf-name");
    const emailEl = form.querySelector("#cf-email");
    const messageEl = form.querySelector("#cf-message");
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const setStatus = (msg, kind) => {
      if (!status) return;
      status.textContent = msg;
      status.classList.remove("hidden");
      status.classList.remove("text-[color:var(--color-success)]", "text-[color:var(--color-error)]");
      status.classList.add(kind === "ok"
        ? "text-[color:var(--color-success)]"
        : "text-[color:var(--color-error)]");
    };

    const setInvalid = (el, bad) => {
      if (!el) return;
      if (bad) el.setAttribute("aria-invalid", "true");
      else el.removeAttribute("aria-invalid");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // 1) Validate in the browser first — show a specific, actionable message
      //    and move focus to the field that needs fixing.
      const name = ((nameEl && nameEl.value) || "").trim();
      const email = ((emailEl && emailEl.value) || "").trim();
      const message = ((messageEl && messageEl.value) || "").trim();
      setInvalid(nameEl, false);
      setInvalid(emailEl, false);
      setInvalid(messageEl, false);

      if (!name || !email || !message) {
        const firstEmpty = !name ? nameEl : !email ? emailEl : messageEl;
        setInvalid(firstEmpty, true);
        setStatus(messages.incomplete, "err");
        if (firstEmpty) firstEmpty.focus();
        return;
      }
      if (!emailRe.test(email)) {
        setInvalid(emailEl, true);
        setStatus(messages.invalidEmail, "err");
        if (emailEl) emailEl.focus();
        return;
      }

      const data = new FormData(form);
      submit.setAttribute("disabled", "true");
      label.textContent = messages.submitting;

      try {
        const res = await fetch(form.action, { method: "POST", body: data });
        if (res.ok) {
          form.reset();
          if (window.turnstile) {
            // Re-render the widget so user can submit again
            const w = form.querySelector(".cf-turnstile");
            if (w) window.turnstile.reset();
          }
          setStatus(messages.success, "ok");
        } else {
          // 2) Map the server's error code to a specific message.
          let code = "";
          try {
            const body = await res.json();
            if (body && typeof body.error === "string") code = body.error;
          } catch (_) {}
          if (code === "invalid_input") {
            setInvalid(emailEl, true);
            setStatus(messages.invalidEmail, "err");
            if (emailEl) emailEl.focus();
          } else {
            // bot_check_failed / email_not_configured / no_recipients / send_failed / unknown
            // — nothing the visitor can fix; offer the direct-email fallback.
            setStatus(messages.serverError, "err");
          }
        }
      } catch (err) {
        console.error(err);
        setStatus(messages.networkError, "err");
      } finally {
        submit.removeAttribute("disabled");
        label.textContent = messages.submit;
      }
    });
  }
</script>
