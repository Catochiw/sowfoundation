---
import type { Lang } from "@i18n/ui";
import { donate } from "@data/donate";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = donate[lang];
---

<div class="donate">
  <!-- Tax-deductible note (lead) -->
  <p class="donate__lead">{d.taxNote}</p>

  <div class="donate__grid">
    <!-- Online giving — the two original PayPal hosted buttons, as real POST
         forms (a GET link to PayPal errors out). -->
    <section class="donate__card">
      <p class="donate__intro">{d.paypalIntro}</p>
      <div class="donate__buttons">
        {d.buttons.map((b) => (
          <form action={b.action} method="post" target="_blank">
            {b.cmd && <input type="hidden" name="cmd" value={b.cmd} />}
            <input type="hidden" name="hosted_button_id" value={b.hostedButtonId} />
            <button type="submit" class="btn btn-primary">
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                <path d="M7.4 21.5h-3a.6.6 0 0 1-.6-.7L6.6 3.4a1 1 0 0 1 1-.9h6.7c2.6 0 4.5.7 5.5 2 .9 1.2 1.1 2.8.7 4.7-.7 3.7-3.1 5.5-7 5.5h-2c-.6 0-1 .4-1.1 1L9.4 21a.6.6 0 0 1-.7.5H7.4z" />
              </svg>
              <span>{b.label}</span>
            </button>
          </form>
        ))}
      </div>
    </section>

    <!-- Mail a check -->
    <section class="donate__card">
      <p class="donate__intro">{d.checkIntro}</p>
      <address class="donate__address">
        {d.addressLines.map((line) => <span>{line}</span>)}
      </address>
    </section>
  </div>

  <!-- Charles Schwab + contact -->
  <div class="donate__grid">
    <section class="donate__card">
      <p class="donate__intro">{d.schwab}</p>
    </section>
    <section class="donate__card">
      <p class="donate__intro">{d.contactIntro}</p>
      <p class="donate__contact">
        <a href={`tel:${d.phone.replace(/[^0-9+]/g, "")}`}>{d.phone}</a>
        <a href="mailto:info@sowfoundation.org">{d.email}</a>
      </p>
    </section>
  </div>

  <p class="donate__thanks">{d.thanks}</p>
</div>

<style>
  .donate { max-width: 880px; margin-inline: auto; }
  .donate__lead {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink-2);
    margin: 0 0 clamp(1.75rem, 3vw, 2.5rem);
  }
  .donate__grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }
  @media (min-width: 720px) {
    .donate__grid { grid-template-columns: 1fr 1fr; }
  }
  .donate__card {
    border: 1px solid var(--color-rule);
    background: var(--color-paper);
    border-radius: 14px;
    padding: clamp(1.5rem, 2.5vw, 2rem);
  }
  .donate__intro {
    margin: 0;
    color: var(--color-ink);
    font-weight: 500;
    line-height: 1.7;
  }
  .donate__buttons {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .donate__buttons form { margin: 0; }
  .donate__address {
    font-style: normal;
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    color: var(--color-ink-2);
  }
  .donate__contact {
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .donate__contact a {
    color: var(--color-ink-2);
    transition: color 150ms ease;
  }
  .donate__contact a:hover { color: var(--color-brand); }
  .donate__thanks {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    text-align: center;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ink);
  }
</style>
