---
import type { Lang } from "@i18n/ui";
import { t } from "@i18n/ui";
import { paypalButtons, checkInfo } from "@data/donation";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="grid gap-8 md:grid-cols-2">
  <!-- PayPal -->
  <div class="card-soft">
    <h3 class="text-xl">{t(lang, "donate.paypal.title")}</h3>
    <p class="mt-2 text-sm text-[color:var(--color-ink-500)]">
      {lang === "zh"
        ? "點選按鈕後將跳轉至 PayPal 完成奉獻,可使用信用卡或 PayPal 帳戶。"
        : "Tap a button to complete your gift on PayPal. Credit card or PayPal account both work."}
    </p>

    <div class="mt-6 space-y-5">
      {paypalButtons.map((b) => (
        <div class="rounded-2xl border border-[color:var(--color-ink-300)] bg-[color:var(--color-ink-50)] p-5">
          <p class="text-sm font-semibold text-[color:var(--color-ink-900)]">
            {t(lang, b.labelKey)}
          </p>
          <p class="mt-1 text-sm text-[color:var(--color-ink-500)]">
            {lang === "zh" ? b.descriptionZh : b.descriptionEn}
          </p>
          <form
            action="https://www.paypal.com/cgi-bin/webscr"
            method="post"
            target="_blank"
            rel="noopener"
            class="mt-4"
          >
            <input type="hidden" name="cmd" value="_s-xclick" />
            <input type="hidden" name="hosted_button_id" value={b.buttonId} />
            <button
              type="submit"
              class="btn btn-primary hover:btn-primary-hover w-full sm:w-auto"
            >
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
                <path d="M7.4 21.5h-3a.6.6 0 0 1-.6-.7L6.6 3.4a1 1 0 0 1 1-.9h6.7c2.6 0 4.5.7 5.5 2 .9 1.2 1.1 2.8.7 4.7-.7 3.7-3.1 5.5-7 5.5h-2c-.6 0-1 .4-1.1 1L9.4 21a.6.6 0 0 1-.7.5H7.4z" />
              </svg>
              <span>{t(lang, "donate.paypal.button")}</span>
            </button>
          </form>
        </div>
      ))}
    </div>
  </div>

  <!-- Check -->
  <div class="card-soft">
    <h3 class="text-xl">{t(lang, "donate.check.title")}</h3>
    <p class="mt-2 text-sm text-[color:var(--color-ink-500)]">
      {lang === "zh"
        ? "請將支票寄至以下地址。我們會郵寄抵稅收據給你。"
        : "Mail your check to the address below. We'll send you a tax receipt by mail."}
    </p>

    <dl class="mt-6 space-y-5 text-sm">
      <div>
        <dt class="text-[color:var(--color-ink-500)]">{t(lang, "donate.check.payee")}</dt>
        <dd class="mt-1 text-[color:var(--color-ink-900)] font-medium text-base">{checkInfo.payee}</dd>
      </div>
      <div>
        <dt class="text-[color:var(--color-ink-500)]">{t(lang, "donate.check.mail_to")}</dt>
        <dd class="mt-1 text-[color:var(--color-ink-900)] font-medium">
          <address class="not-italic space-y-0.5">
            {checkInfo.mailToLines.map((line) => <div>{line}</div>)}
          </address>
        </dd>
      </div>
    </dl>
  </div>
</div>

<div class="mt-8 rounded-2xl bg-[color:var(--color-brand-50)] border border-[color:var(--color-brand-500)]/30 p-5">
  <div class="flex items-start gap-3">
    <svg class="mt-0.5 size-5 text-[color:var(--color-brand-700)] shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v.75a.75.75 0 001.5 0V5zm0 4a.75.75 0 00-1.5 0v5.5a.75.75 0 001.5 0V9z" clip-rule="evenodd" />
    </svg>
    <p class="text-sm text-[color:var(--color-ink-700)]">
      {t(lang, "donate.tax.note")}
    </p>
  </div>
</div>
