---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  banner?: string;
}
const { eyebrow, title, subtitle, banner } = Astro.props;
---

<section class="page-hero">
  <div class="container-wide">
    <div class="page-hero__inner">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="page-hero__title">{title}</h1>
      {subtitle && <p class="page-hero__sub">{subtitle}</p>}
    </div>

    {banner && (
      <figure class="page-hero__figure">
        <img src={banner} alt="" loading="eager" fetchpriority="high" />
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3rem, 6vw, 5rem) 0;
    background: var(--color-canvas);
  }
  .page-hero__inner {
    max-width: 760px;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .page-hero__title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.25rem, 4vw + 1rem, 4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }
  .page-hero__sub {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.5vw + 0.85rem, 1.125rem);
    line-height: 1.7;
    color: var(--color-ink-3);
    margin: 1.25rem 0 0;
    max-width: 600px;
  }
  .page-hero__figure {
    margin: 0;
    aspect-ratio: 21 / 9;
    background: var(--color-rule-2);
    overflow: hidden;
  }
  .page-hero__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
