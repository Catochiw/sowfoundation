---
import type { Lang } from "@i18n/ui";
import { t } from "@i18n/ui";
import { nav, localizedHref } from "@data/nav";
import LangSwitcher from "@components/LangSwitcher.astro";

interface Props {
  lang: Lang;
  pathWithoutLang: string;
}

const { lang, pathWithoutLang } = Astro.props;
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[color-mix(in_oklab,var(--color-canvas)_88%,transparent)] border-b border-[color:var(--color-rule)]">
  <div class="container-edge flex h-[64px] items-center justify-between gap-6">
    <a
      href={`/${lang}`}
      class="flex items-center gap-2.5 text-[color:var(--color-ink)] hover:text-[color:var(--color-ink)]"
      aria-label={t(lang, "site.name")}
    >
      <img src="/sow-logo.png" alt="" width="28" height="28" class="opacity-90" />
      <span class="font-serif text-lg tracking-tight">{t(lang, "site.name")}</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-0.5 text-sm">
        {nav.map((item) => (
          <li class="relative group">
            <a
              href={localizedHref(lang, item.href)}
              class="inline-flex items-center gap-1 px-3 py-2 text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]"
            >
              <span>{t(lang, item.labelKey as any)}</span>
              {item.children && (
                <svg class="size-3 opacity-60" viewBox="0 0 12 12" fill="none">
                  <path d="M3 4.5 6 7.5l3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-1/2 top-full -translate-x-1/2 hidden group-hover:block group-focus-within:block pt-2">
                <ul class="min-w-[200px] border border-[color:var(--color-rule)] bg-[color:var(--color-paper)] p-1.5 shadow-[0_12px_36px_-12px_rgba(0,0,0,0.12)]">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={localizedHref(lang, child.href)}
                        class="block px-3 py-2 text-sm text-[color:var(--color-ink-2)] hover:bg-[color:var(--color-canvas)] hover:text-[color:var(--color-ink)]"
                      >
                        {t(lang, child.labelKey as any)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <LangSwitcher lang={lang} pathWithoutLang={pathWithoutLang} />

      <a
        href={localizedHref(lang, "/donate")}
        class="hidden md:inline-flex btn btn-primary text-xs py-2 px-4"
      >
        {t(lang, "nav.donate")}
      </a>

      <button
        type="button"
        class="lg:hidden inline-flex size-9 items-center justify-center border border-[color:var(--color-rule)] text-[color:var(--color-ink)]"
        aria-label={t(lang, "nav.menu")}
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-mobile-toggle
      >
        <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="lg:hidden hidden border-t border-[color:var(--color-rule)] bg-[color:var(--color-paper)]"
    data-mobile-nav
  >
    <nav class="container-wide py-4" aria-label="Mobile">
      <ul class="flex flex-col gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={localizedHref(lang, item.href)}
              class="block px-3 py-2.5 text-base font-medium text-[color:var(--color-ink)] hover:bg-[color:var(--color-canvas)]"
            >
              {t(lang, item.labelKey as any)}
            </a>
            {item.children && (
              <ul class="ml-3 mt-1 mb-2 flex flex-col gap-0.5 border-l border-[color:var(--color-rule)] pl-3">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={localizedHref(lang, child.href)}
                      class="block px-3 py-2 text-sm text-[color:var(--color-ink-2)] hover:bg-[color:var(--color-canvas)] hover:text-[color:var(--color-ink)]"
                    >
                      {t(lang, child.labelKey as any)}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li class="mt-2">
          <a
            href={localizedHref(lang, "/donate")}
            class="btn btn-primary w-full justify-center"
          >
            {t(lang, "nav.donate")}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
  const drawer = document.querySelector<HTMLElement>("[data-mobile-nav]");
  if (btn && drawer) {
    btn.addEventListener("click", () => {
      const open = drawer.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(open));
    });
  }
</script>
