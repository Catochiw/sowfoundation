---
import type { Lang } from "@i18n/ui";
import { t } from "@i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <p class="hero__est">
      <span>Est. 2016</span>
      <span class="hero__est-dot" aria-hidden="true">·</span>
      <span>Pleasanton, California</span>
    </p>

    <!-- Centered brand mark. The logo already carries the
         "Serving Others Worldwide" wordmark, so no slogan is layered on. -->
    <a href={`/${lang}`} class="hero__mark" aria-label={t(lang, "site.name")}>
      <img src="/sow-logo.png" alt={t(lang, "site.name")} width="500" height="206" />
    </a>
  </div>
</section>

<style>
  .hero {
    background: var(--color-canvas);
    text-align: center;
  }
  .hero__inner {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(2.25rem, 4vw, 3.5rem) 1.5rem clamp(2rem, 3.5vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__est {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink-3);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
  }
  .hero__est-dot { opacity: 0.5; }
  .hero__mark {
    display: inline-flex;
    transition: opacity 200ms ease;
  }
  .hero__mark:hover { opacity: 0.85; }
  .hero__mark img {
    width: clamp(220px, 28vw, 320px);
    height: auto;
  }
</style>
