---
import type { Lang } from "@i18n/ui";
import { allLocales, languages } from "@i18n/ui";

interface Props {
  lang: Lang;
  pathWithoutLang: string;
}
const { lang, pathWithoutLang } = Astro.props;
const normalizedPath = pathWithoutLang || "";
---

<div class="inline-flex items-center rounded-full border border-[color:var(--color-ink-300)] bg-white p-0.5 text-xs font-medium" role="group" aria-label="Language">
  {allLocales.map((loc) => {
    const isActive = loc === lang;
    const href = `/${loc}${normalizedPath}`.replace(/\/$/, "") || `/${loc}`;
    return (
      <a
        href={href}
        aria-current={isActive ? "true" : "false"}
        class:list={[
          "rounded-full px-3 py-1 transition-colors",
          isActive
            ? "bg-[color:var(--color-ink-900)] text-white"
            : "text-[color:var(--color-ink-700)] hover:text-[color:var(--color-ink-900)]",
        ]}
        title={languages[loc]}
      >
        {loc === "zh" ? "中" : "EN"}
      </a>
    );
  })}
</div>
