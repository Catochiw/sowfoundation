---
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/PageHero.astro";
import { getCollection } from "astro:content";
import { allLocales, type Lang, t } from "@i18n/ui";
import { localizedHref } from "@data/nav";

export async function getStaticPaths() {
  return allLocales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };

const programs = (
  await getCollection("pages", ({ data }) => data.lang === lang && data.group === "programs")
).sort((a, b) => a.data.order - b.data.order);
---

<Layout lang={lang} title={t(lang, "nav.programs")} pathWithoutLang="/programs">
  <PageHero
    eyebrow={t(lang, "site.tagline")}
    title={t(lang, "nav.programs")}
    subtitle={t(lang, "home.programs.subtitle")}
  />

  <section class="section">
    <div class="container-wide">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {programs.map((p) => {
          const slug = p.id.split("/").pop()?.replace(/\.md$/, "") ?? "";
          return (
            <a href={localizedHref(lang, `/programs/${slug}`)} class="card-soft block group">
              <h3 class="text-xl group-hover:text-[color:var(--color-brand-700)] transition-colors">
                {p.data.title}
              </h3>
              {p.data.summary && <p class="mt-3 text-sm text-[color:var(--color-ink-500)]">{p.data.summary}</p>}
              <p class="mt-5 text-sm font-medium text-[color:var(--color-brand-600)]">
                {t(lang, "common.read_more")} →
              </p>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
