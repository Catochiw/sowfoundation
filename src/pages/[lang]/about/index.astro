---
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/PageHero.astro";
import { getCollection } from "astro:content";
import { allLocales, type Lang, t } from "@i18n/ui";
import { localizedHref } from "@data/nav";

export async function getStaticPaths() {
  return allLocales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };

const aboutPages = (
  await getCollection("pages", ({ data }) => data.lang === lang && data.group === "about")
).sort((a, b) => a.data.order - b.data.order);
---

<Layout lang={lang} title={t(lang, "nav.about")} pathWithoutLang="/about">
  <PageHero eyebrow={t(lang, "site.tagline")} title={t(lang, "nav.about")} />

  <section class="section">
    <div class="container-prose">
      <ul class="index-list">
        {aboutPages.map((p) => {
          const slug = p.id.split("/").pop() ?? "";
          return (
            <li>
              <a href={localizedHref(lang, `/about/${slug}`)}>
                <span class="index-list__title">{p.data.title}</span>
                <span class="index-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Layout>
