---
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/PageHero.astro";
import DonateButtons from "@components/DonateButtons.astro";
import { allLocales, type Lang, t } from "@i18n/ui";

export async function getStaticPaths() {
  return allLocales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const title = lang === "zh" ? "奉獻" : "Donate";
---

<Layout lang={lang} title={title} pathWithoutLang="/donate">
  <PageHero
    eyebrow={t(lang, "site.tagline")}
    title={title}
    banner="/images/20180309/20180309202320_25521.jpg"
  />

  <section class="section">
    <div class="container-wide">
      <DonateButtons lang={lang} />
    </div>
  </section>
</Layout>
