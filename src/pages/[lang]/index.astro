---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import { getCollection, render } from "astro:content";
import { allLocales, type Lang } from "@i18n/ui";

export async function getStaticPaths() {
  return allLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

// The homepage body is the original CMS "home" page, verbatim:
// 關於我們 / 願景 / 使命 + the ministry sections. Single source of truth.
const pages = await getCollection("pages", ({ data }) => data.lang === lang && data.group === "home");
const home = pages[0];
const { Content } = home ? await render(home) : { Content: null };
---

<Layout lang={lang} pathWithoutLang="">
  <!-- Grand centered brand mark -->
  <Hero lang={lang} />

  <!-- Original homepage copy, rendered faithfully from home.md
       (關於我們 / 願景 / 使命 + the ministry sections). No invented copy. -->
  {Content && (
    <section id="about" class="section">
      <article class="container-prose prose-content home-prose">
        <Content />
      </article>
    </section>
  )}
</Layout>

<style>
  /* Homepage body — slightly grander rhythm than a normal article,
     so the ministry sections read as an editorial spread. */
  .home-prose {
    font-size: 1.0625rem;
  }
  .home-prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
    letter-spacing: -0.02em;
    margin-top: clamp(3rem, 6vw, 5rem);
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }
  .home-prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.25rem, 1vw + 0.9rem, 1.6rem);
    margin-top: 2.25rem;
    margin-bottom: 0.5rem;
  }
  .home-prose :global(img) {
    width: 100%;
    border-radius: 2px;
    margin-block: 1.75rem;
  }
  .home-prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin-block: clamp(2.5rem, 5vw, 4rem);
  }
  .home-prose :global(p) {
    line-height: 1.8;
    color: var(--color-ink-2);
  }
</style>
