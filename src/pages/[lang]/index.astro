---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import HomeSlider from "@components/HomeSlider.astro";
import { getCollection } from "astro:content";
import { allLocales, type Lang, t } from "@i18n/ui";
import { localizedHref } from "@data/nav";

export async function getStaticPaths() {
  return allLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const all = await getCollection("pages", ({ data }) => data.lang === lang);

const programs = all
  .filter((p) => p.data.group === "programs")
  .sort((a, b) => a.data.order - b.data.order);
const tours = (await getCollection("tours", ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout lang={lang} pathWithoutLang="">
  <!-- Centred brand hero -->
  <Hero lang={lang} />

  <!-- Featured highlights (slider) -->
  <section id="explore" class="section-tight" aria-labelledby="featured-heading">
    <div class="container-wide">
      <header class="mb-8 flex items-end justify-between gap-4">
        <h2 id="featured-heading" class="text-2xl sm:text-3xl">
          {lang === "zh" ? "近期事工" : "Featured"}
        </h2>
        <p class="hidden sm:block text-sm text-[color:var(--color-ink-500)]">
          {lang === "zh" ? "最近的行程與項目" : "What's happening now"}
        </p>
      </header>
    </div>
    <HomeSlider lang={lang} />
  </section>

  <!-- Programs grid -->
  <section class="section section-alt">
    <div class="container-wide">
      <header class="mb-12 text-center">
        <h2>{t(lang, "home.programs.title")}</h2>
        <p class="mt-3 text-[color:var(--color-ink-500)] max-w-2xl mx-auto">
          {t(lang, "home.programs.subtitle")}
        </p>
      </header>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {programs.map((p) => (
          <a
            href={localizedHref(lang, `/programs/${p.id.split("/").pop()}`)}
            class="card-soft block group"
          >
            <h3 class="text-xl group-hover:text-[color:var(--color-brand-700)] transition-colors">
              {p.data.title}
            </h3>
            <p class="mt-3 text-sm text-[color:var(--color-ink-500)] line-clamp-3">
              {p.data.summary ?? ""}
            </p>
            <p class="mt-5 text-sm font-medium text-[color:var(--color-brand-600)]">
              {t(lang, "common.read_more")} →
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Tours -->
  {tours.length > 0 && (
    <section class="section">
      <div class="container-wide">
        <header class="mb-12 text-center">
          <h2>{t(lang, "home.tours.title")}</h2>
          <p class="mt-3 text-[color:var(--color-ink-500)] max-w-2xl mx-auto">
            {t(lang, "home.tours.subtitle")}
          </p>
        </header>

        <div class="grid gap-6 md:grid-cols-2">
          {tours.map((tour) => {
            const slug = tour.id.split("/").pop() ?? "";
            return (
              <a
                href={localizedHref(lang, `/tours/${slug}`)}
                class="group relative overflow-hidden rounded-2xl bg-[color:var(--color-ink-100)] border border-[color:var(--color-ink-300)] hover:border-[color:var(--color-ink-500)] transition-colors"
              >
                {tour.data.banner && (
                  <div class="aspect-[16/9] overflow-hidden">
                    <img
                      src={tour.data.banner}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                  </div>
                )}
                <div class="p-6">
                  <h3 class="text-xl">{tour.data.title}</h3>
                  {tour.data.dateRange && (
                    <p class="mt-1 text-sm text-[color:var(--color-ink-500)]">
                      {tour.data.dateRange}
                    </p>
                  )}
                  {tour.data.summary && (
                    <p class="mt-3 text-sm text-[color:var(--color-ink-700)] line-clamp-2">
                      {tour.data.summary}
                    </p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Donate banner -->
  <section class="section section-alt">
    <div class="container-prose text-center">
      <h2>{t(lang, "home.donate.title")}</h2>
      <p class="mt-4 text-lg text-[color:var(--color-ink-500)]">
        {t(lang, "home.donate.subtitle")}
      </p>
      <div class="mt-7">
        <a href={localizedHref(lang, "/donate")} class="btn btn-primary">
          {t(lang, "nav.donate")}
        </a>
      </div>
    </div>
  </section>

</Layout>
