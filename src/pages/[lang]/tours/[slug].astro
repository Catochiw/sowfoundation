---
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/PageHero.astro";
import { getCollection, render } from "astro:content";
import { allLocales, type Lang, t } from "@i18n/ui";

export async function getStaticPaths() {
  const paths: { params: { lang: Lang; slug: string } }[] = [];
  const seen = new Set<string>();
  for (const lang of allLocales) {
    const pages = await getCollection("pages", ({ data }) => data.lang === lang && data.group === "tours");
    for (const page of pages) {
      const slug = page.id.split("/").pop() ?? "";
      const key = `${lang}/${slug}`;
      if (!seen.has(key)) {
        seen.add(key);
        paths.push({ params: { lang, slug } });
      }
    }
    const tours = await getCollection("tours", ({ data }) => data.lang === lang);
    for (const tour of tours) {
      const slug = tour.id.split("/").pop() ?? "";
      const key = `${lang}/${slug}`;
      if (!seen.has(key)) {
        seen.add(key);
        paths.push({ params: { lang, slug } });
      }
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };

const pagesTours = await getCollection("pages", ({ data }) => data.lang === lang && data.group === "tours");
const tours = await getCollection("tours", ({ data }) => data.lang === lang);

const entry =
  pagesTours.find((p) => p.id === `${lang}/${slug}` || p.id.endsWith(`/${slug}`)) ??
  tours.find((p) => p.id === `${lang}/${slug}` || p.id.endsWith(`/${slug}`));

if (!entry) return new Response("Not found", { status: 404 });

const { Content } = await render(entry);
const tourMeta = "dateRange" in entry.data ? entry.data : null;
---

<Layout lang={lang} title={entry.data.title} pathWithoutLang={`/tours/${slug}`}>
  <PageHero
    eyebrow={t(lang, "nav.tours")}
    title={entry.data.title}
    subtitle={tourMeta?.dateRange}
    banner={entry.data.banner}
  />

  {tourMeta?.priceUSD && (
    <section class="section-tight">
      <div class="container-prose">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-4 text-sm">
          {tourMeta.dateRange && (
            <div>
              <dt class="text-[color:var(--color-ink-500)] mb-1">{lang === "zh" ? "日期" : "Dates"}</dt>
              <dd class="text-[color:var(--color-ink-900)] font-medium">{tourMeta.dateRange}</dd>
            </div>
          )}
          <div>
            <dt class="text-[color:var(--color-ink-500)] mb-1">{lang === "zh" ? "費用" : "Price"}</dt>
            <dd class="text-[color:var(--color-ink-900)] font-medium">${tourMeta.priceUSD} USD</dd>
          </div>
          <div>
            <dt class="text-[color:var(--color-ink-500)] mb-1">{lang === "zh" ? "狀態" : "Status"}</dt>
            <dd class="text-[color:var(--color-ink-900)] font-medium capitalize">{tourMeta.status}</dd>
          </div>
        </dl>
      </div>
    </section>
  )}

  <section class="section">
    <article class="container-prose prose-content">
      <Content />
    </article>
  </section>
</Layout>
