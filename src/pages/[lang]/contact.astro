---
import Layout from "@layouts/Layout.astro";
import PageHero from "@components/PageHero.astro";
import ContactForm from "@components/ContactForm.astro";
import { allLocales, type Lang, t } from "@i18n/ui";
import { contactInfo } from "@data/site";

export async function getStaticPaths() {
  return allLocales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
---

<Layout lang={lang} title={t(lang, "contact.title")} pathWithoutLang="/contact">
  <PageHero
    eyebrow={t(lang, "site.tagline")}
    title={t(lang, "contact.title")}
    subtitle={t(lang, "contact.intro")}
  />

  <section class="section">
    <div class="container-wide max-w-5xl">
      <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
        <div>
          <ContactForm lang={lang} />
        </div>
        <aside class="space-y-6">
          <div>
            <h4 class="eyebrow">{t(lang, "contact.address")}</h4>
            <address class="not-italic mt-1 text-[color:var(--color-ink)]">
              {contactInfo.address}
            </address>
          </div>
          <div>
            <h4 class="eyebrow">{t(lang, "contact.phone")}</h4>
            <p class="mt-1">
              <a href={`tel:${contactInfo.phone.replace(/[^0-9+]/g, "")}`} class="text-[color:var(--color-ink)] hover:text-[color:var(--color-brand)]">
                {contactInfo.phone}
              </a>
            </p>
          </div>
          <div>
            <h4 class="eyebrow">{t(lang, "contact.email")}</h4>
            <p class="mt-1">
              <a href={`mailto:${contactInfo.emailContact}`} class="text-[color:var(--color-ink)] hover:text-[color:var(--color-brand)]">
                {contactInfo.emailContact}
              </a>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
