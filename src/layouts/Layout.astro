---
import "@/styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import type { Lang } from "@i18n/ui";
import { t } from "@i18n/ui";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  /** Path of the current page WITHOUT the leading /{lang}; used for hreflang alternates */
  pathWithoutLang?: string;
  /** Extra class on <main> */
  mainClass?: string;
}

const {
  lang,
  title,
  description,
  ogImage = "/sow-logo.png",
  pathWithoutLang = "",
  mainClass = "",
} = Astro.props;

const siteName = t(lang, "site.name");
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} · ${t(lang, "site.tagline")}`;
const desc = description ?? t(lang, "site.description");

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const htmlLang = lang === "zh" ? "zh-Hant" : "en-US";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="zh-Hant" href={new URL(`/zh${pathWithoutLang}`, Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${pathWithoutLang}`, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/zh${pathWithoutLang}`, Astro.site).toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content={htmlLang.replace("-", "_")} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Icons -->
    <link rel="icon" type="image/png" href="/sow-logo.png" />
    <link rel="apple-touch-icon" href="/sow-logo.png" />

    <meta name="theme-color" content="#fbfaf6" />

    <!-- Fonts: Source Serif 4 (Adobe, designed to pair with Source Han Serif)
         + Noto Serif TC for Traditional Chinese. Both shipped self-hosted via
         Google Fonts CDN with display=swap so first paint isn't blocked. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Noto+Serif+TC:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg focus:outline focus:outline-2 focus:outline-[color:var(--color-brand-600)]"
    >
      Skip to content
    </a>

    <Header lang={lang} pathWithoutLang={pathWithoutLang} />

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  html, body { margin: 0; padding: 0; }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
