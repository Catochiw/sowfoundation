{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/page/home", "destination": "/zh", "permanent": true },
    { "source": "/page/org", "destination": "/zh/about/org", "permanent": true },
    { "source": "/page/directors", "destination": "/zh/about/directors", "permanent": true },
    { "source": "/page/zz", "destination": "/zh/programs/senior-care", "permanent": true },
    { "source": "/page/jz", "destination": "/zh/programs/disaster-relief", "permanent": true },
    { "source": "/page/fp", "destination": "/zh/programs/poverty-relief", "permanent": true },
    { "source": "/page/zx", "destination": "/zh/programs/scholarship", "permanent": true },
    { "source": "/page/co", "destination": "/zh/programs/pandemic-response", "permanent": true },
    { "source": "/page/ly", "destination": "/zh/tours/holy-land", "permanent": true },
    { "source": "/page/fz", "destination": "/zh/tours/ark", "permanent": true },
    { "source": "/page/lc", "destination": "/zh/reports/longchuan", "permanent": true },
    { "source": "/page/donation", "destination": "/zh/donate", "permanent": true },
    { "source": "/contact", "destination": "/zh/contact", "permanent": true },
    { "source": "/SOW_2026_Tour", "destination": "/zh/tours/2026-greece-turkey", "permanent": true },
    { "source": "/SOW_2026_Tour/(.*)", "destination": "/zh/tours/2026-greece-turkey", "permanent": true },
    { "source": "/SOW_Greece_and_Turkey_2025", "destination": "/zh/tours", "permanent": true },
    { "source": "/SOW_Greece_and_Turkey_2025/(.*)", "destination": "/zh/tours", "permanent": true },
    { "source": "/turkey.php", "destination": "/zh/tours", "permanent": true },
    { "source": "/en", "destination": "/en", "permanent": false },
    { "source": "/zh", "destination": "/zh", "permanent": false }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
